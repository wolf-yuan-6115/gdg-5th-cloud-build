{
  "name": "cloud-build-food-demo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start --hostname 0.0.0.0",
    "lint": "bun --bun eslint .",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun test tests",
    "check": "bun run lint && bun run typecheck && bun test tests"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
}
